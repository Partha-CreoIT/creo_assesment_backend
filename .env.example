# Copy to .env and adjust as needed.
PORT=8080
DATABASE_URL=postgres://exam:exam@localhost:5433/exam_taker?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
PISTON_URL=http://localhost:2000
# Code runner: auto (probe piston, fall back to docker-exec) | piston | docker
RUNNER=auto
RUNNER_CONTAINER=exam_taker_runner
CORS_ORIGINS=http://localhost:3000
# Seconds of grace after exam end during which late answer saves are still accepted.
ANSWER_GRACE_SEC=30
# Max concurrent /me/run executions, process-wide.
RUN_CONCURRENCY=8
# Background grading worker pool size.
GRADER_WORKERS=4
# How long a run request waits for a free concurrency slot before returning 429.
RUN_QUEUE_TIMEOUT_SEC=20
# Minimum seconds between /me/run calls for a single session.
RUN_RATE_LIMIT_SEC=2
